# ==============================================================================
# AP VISUAL HOUSE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, CORS verification, and API endpoints.
# [Category: Normal Configuration]
APP_URL="MY_APP_URL"

# ==============================================================================
# GOOGLE CLOUD STORAGE (PRIVATE BUCKET CONFIGURATION)
# ==============================================================================
# GCS_BUCKET_NAME: Name of the private Google Cloud Storage bucket used for
# temporary uploads (temporary/{requestId}/{fileId}) and confirmed project
# objects (confirmed/{requestId}/{fileId}).
# [Category: Normal Configuration — NOT A SECRET]
# Production Default: "ap-visual-house-uploads-0268928491"
GCS_BUCKET_NAME="ap-visual-house-uploads-0268928491"

# GCS_PROJECT_ID & GCP_PROJECT_ID: Google Cloud project ID.
# When running in Cloud Run, the Google Cloud SDK automatically derives this
# from the environment metadata server.
# [Category: Normal Configuration — NOT A SECRET]
# Production Project: "gen-lang-client-0268928491"
GCS_PROJECT_ID="gen-lang-client-0268928491"
GCP_PROJECT_ID="gen-lang-client-0268928491"

# STORAGE_ENV: Explicit storage environment ("production", "development", or "test").
# In production, real Google Cloud Storage is MANDATORY and cannot fall back to any emulator.
STORAGE_ENV="production"

# STORAGE_USE_EMULATOR: Local development / test emulator flag.
# Set to "true" ONLY in local development or test suites where GCS access is unavailable.
# STRICTLY FORBIDDEN IN PRODUCTION: Ignored and causes fatal startup error if NODE_ENV=production.
STORAGE_USE_EMULATOR="false"

# TEMP_UPLOAD_RETENTION_HOURS: Retention window in hours for abandoned temporary uploads
# in the private GCS bucket before automatic deletion.
# Enforced by GCS bucket lifecycle rule and background application sweeper.
# [Category: Normal Configuration — NOT A SECRET]
# Default: 24
TEMP_UPLOAD_RETENTION_HOURS=24

# ==============================================================================
# SECURITY & AUTHENTICATION NOTE (NO SERVICE ACCOUNT KEYS REQUIRED)
# ==============================================================================
# Cloud Run uses its assigned Service Account Identity (Application Default Credentials).
# DO NOT paste or embed service-account private keys or JSON secret keys here.
# Permissions required: roles/storage.objectAdmin on the private GCS bucket.

# ==============================================================================
# GOOGLE DRIVE OWNER OAUTH 2.0 (PHASE 5.3A HARDENED — SECRET MANAGER)
# ==============================================================================
# In accordance with Phase 5.3A security hardening, customer file storage in
# private GCS is STRICTLY SEPARATED from OAuth credential storage.
# Secrets are stored in Google Cloud Secret Manager (project gen-lang-client-0268928491).
# The Cloud Run Service Account (ap-visual-cloudrun-sa@gen-lang-client-0268928491.iam.gserviceaccount.com)
# receives roles/secretmanager.secretAccessor ONLY on these secrets.
#
# Secret Manager Secret: "google-drive-client-secret"
# Mounted in Cloud Run via: --set-secrets="GOOGLE_DRIVE_CLIENT_SECRET=google-drive-client-secret:latest"
GOOGLE_DRIVE_CLIENT_SECRET=

# Secret Manager Secret: "google-drive-refresh-token"
# Mounted in Cloud Run via: --set-secrets="GOOGLE_DRIVE_REFRESH_TOKEN=google-drive-refresh-token:latest"
GOOGLE_DRIVE_REFRESH_TOKEN=

# Secret Manager Secret: "drive-oauth-hmac-secret"
# Mounted in Cloud Run via: --set-secrets="DRIVE_OAUTH_HMAC_SECRET=drive-oauth-hmac-secret:latest"
DRIVE_OAUTH_HMAC_SECRET=

# GOOGLE_DRIVE_CLIENT_ID: Standard Non-Secret Configuration
# Client ID for Web Application created in Google Cloud Console
GOOGLE_DRIVE_CLIENT_ID="761522439396-bphkf3ir4agk518k3d4iu3ovf85docqh.apps.googleusercontent.com"

# GOOGLE_DRIVE_REDIRECT_URI: Standard Non-Secret Configuration
# Authorized redirect URI configured in Google Cloud Console Credentials
# Production Default: https://ap-visual-house-w627tfzezq-as.a.run.app/api/drive/oauth/callback
GOOGLE_DRIVE_REDIRECT_URI=https://ap-visual-house-w627tfzezq-as.a.run.app/api/drive/oauth/callback

